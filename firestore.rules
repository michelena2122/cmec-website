rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- GLOBAL HELPERS ---
    function isSignedIn() { return request.auth != null; }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return isSignedIn() && getUserData().role == 'admin'; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128; }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isOwner(userId);
    }

    // --- SOCIOS COLLECTION ---
    match /socios/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow update: if isOwner(userId) && (
        // Socio can only update profile fields, not status or cuotas
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['telefono', 'apellidos', 'puesto'])
      ) || isAdmin();
      allow create, delete: if isAdmin();
    }

    // --- PUBLIC CONTENT (News, Sessions, Allies) ---
    match /noticias/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /sesiones/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /publicaciones/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- PAYMENTS ---
    match /pagos/{pagoId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn(); // Payments are updated via server/webhook
      allow update, delete: if isAdmin();
    }
  }
}
